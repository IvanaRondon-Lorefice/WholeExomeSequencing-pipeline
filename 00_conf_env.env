CONDA_ACTIVATE="/path/to/anaconda/"
CONDA_ENV_WES="/path/to/conda_envs/WESenv"

JOBS_DIR="Scripts/jobs/"

R_LIBRARY_PATH="/path/to/R_libraries/"


# ===================================================
#  CONDITIONAL EXPERIMENT
# ===================================================

PON="Yes"
MATCH="Yes"


# ===================================================
